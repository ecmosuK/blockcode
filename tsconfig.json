{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist",
    "types": ["node", "jest"]
  },
  "include": [
    "desktop/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}