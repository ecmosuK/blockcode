{
  "name": "blockcode-windows",
  "version": "1.0.7",
  "private": true,
  "description": "BlockCode visual coding playground for Windows",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "node desktop/prepare-eim-cli.cjs && electron-builder --dir",
    "prepare:eim": "node desktop/prepare-eim-cli.cjs",
    "dist": "node desktop/prepare-eim-cli.cjs && node desktop/build-installer.cjs",
    "release": "node desktop/prepare-eim-cli.cjs && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.blockcode.desktop",
    "productName": "BlockCode",
    "artifactName": "blockcode setup.exe",
    "publish": {
      "provider": "github",
      "owner": "ecmosuK",
      "repo": "blockcode",
      "releaseType": "release"
    },
    "extraResources": [
      {
        "from": "tools/build-service.py",
        "to": "blockcode-build-service/tools/build-service.py"
      },
      {
        "from": "tools/eim-cli.exe",
        "to": "blockcode-build-service/eim-cli.exe"
      },
      {
        "from": "tools/toolchain-manifest.json",
        "to": "toolchain-manifest.json"
      },
      {
        "from": "watch-elf-app",
        "to": "blockcode-build-service/watch-elf-app",
        "filter": [
          "**/*",
          "!build/**",
          "!managed_components/**/test_apps/**",
          "!managed_components/**/tests/**"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "index.html",
      "styles.css",
      "app.js",
      "scripts/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "include": "desktop/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
